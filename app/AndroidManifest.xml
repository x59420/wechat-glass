<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.zaka.wechatglass">

    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <application
        android:label="wxglass"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <!--
            没有 Activity、没有桌面图标：
            设置入口是微信「我」页面里「设置」上方那一行 wxglass（见 WxMenuEntry），
            由微信自己的偏好列表渲染，模块不额外占用桌面。
        -->

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="wxglass —— 只把微信底部导航栏换成液态玻璃 Dock，交互仍走微信原生。" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedscope" android:value="com.tencent.mm" />
    </application>
</manifest>
